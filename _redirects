# Cloudflare Pages redirects for retired Squarespace URLs.
# Only URLs that carried real traffic or inbound links are redirected.
# Everything else (e.g. /cart, /*-old) is left to return 404, which is
# the correct signal for a page that should be dropped from the index.

/home         /        301
/blog/tag/*   /blog/   301

# Retired Squarespace category and placeholder-post URLs still shown in search.
/blog/category/*          /blog/   301
/blog/blog-post-title-*   /blog/   301

# Repair tracking links that lost their "?" when pasted into LinkedIn,
# e.g. /blog/<slug>/utm_source=linkedin&utm_medium=social...
/blog/:slug/utm_source=*  /blog/:slug/?utm_source=:splat  301
